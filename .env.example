# =============================================================
# Logistics Platform – Environment Variables Example
# =============================================================
# Copy this file to .env and customize values for local development.
# NEVER commit .env to version control.
# =============================================================

# ----- Service Ports (all have sensible defaults in application.yml) -----
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
SHIPMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# ----- Backend Service URLs used by API Gateway -----
USER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
SHIPMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# ----- Infrastructure Ports (docker-compose.yml) -----
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PORT=6379

KAFKA_PORT=9092
KAFKA_UI_PORT=8090

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----- Database-per-Service Credentials & URLs -----
# Each service connects ONLY to its dedicated database with its own credentials.
# Cross-service database access is strictly blocked at the PostgreSQL level.
DB_HOST=localhost
DB_PORT=5432

# user-service
USER_SERVICE_DB_NAME=user_db
USER_SERVICE_DB_USER=user_service_user
USER_SERVICE_DB_PASSWORD=user_password

# order-service
ORDER_SERVICE_DB_NAME=order_db
ORDER_SERVICE_DB_USER=order_service_user
ORDER_SERVICE_DB_PASSWORD=order_password

# shipment-service
SHIPMENT_SERVICE_DB_NAME=shipment_db
SHIPMENT_SERVICE_DB_USER=shipment_service_user
SHIPMENT_SERVICE_DB_PASSWORD=shipment_password

# notification-service
NOTIFICATION_SERVICE_DB_NAME=notification_db
NOTIFICATION_SERVICE_DB_USER=notification_service_user
NOTIFICATION_SERVICE_DB_PASSWORD=notification_password

# ----- Apache Kafka Configuration (PB-005) -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=logistics-service-group

# ----- Redis In-Memory Store & Cache (PB-006) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT & Authentication (PB-009) -----
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=logistics-platform

