# =============================================================
# Logistics Platform – Environment Variables Example
# =============================================================
# Copy this file to .env and customize values for local development.
# NEVER commit .env to version control.
# =============================================================

# ----- Service Ports (all have sensible defaults in application.yml) -----
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
SHIPMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# ----- Backend Service URLs used by API Gateway -----
# In local development outside Docker:
USER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
SHIPMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# ----- Local Infrastructure Ports (docker-compose.yml) -----
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PORT=6379

KAFKA_PORT=9092
KAFKA_UI_PORT=8090

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----- Database Connection Defaults (for backend services in future PBs) -----
# USER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/user_db
# ORDER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/order_db
# SHIPMENT_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/shipment_db
# NOTIFICATION_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/notification_db

# ----- Message Broker & Cache (for backend services in future PBs) -----
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_HOST=localhost
# REDIS_PORT=6379
